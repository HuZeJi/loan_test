<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>TIMESTAMP: %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} | TRANSACTION: %X{transactionId:-N/A} | API: %X{api:-N/A} | USER_ID: %X{userId:-anonymous} | %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
